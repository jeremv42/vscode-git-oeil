{
  "name": "git-oeil",
  "displayName": "Git Œil",
  "description": "Blame inline sur la ligne courante, et vue stashs / branches / branches récentes dans le contrôle de source.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Git Œil",
      "properties": {
        "gitOeil.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Afficher le blame en fin de ligne courante."
        },
        "gitOeil.blame.delayMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Délai (ms) après un déplacement du curseur ou une frappe avant de calculer le blame."
        },
        "gitOeil.recentBranches.count": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Nombre de branches récemment utilisées (lues dans le reflog) affichées. 0 pour masquer le groupe."
        }
      }
    },
    "colors": [
      {
        "id": "gitOeil.blameForeground",
        "description": "Couleur du texte de blame en fin de ligne.",
        "defaults": {
          "dark": "#ffffff55",
          "light": "#00000055",
          "highContrast": "#ffffff99",
          "highContrastLight": "#00000099"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitOeil.refs",
          "name": "Stashs & branches",
          "icon": "$(git-branch)"
        }
      ]
    },
    "commands": [
      { "command": "gitOeil.toggleBlame", "title": "Git Œil : afficher / masquer le blame inline" },
      { "command": "gitOeil.refresh", "title": "Rafraîchir", "icon": "$(refresh)", "category": "Git Œil" },
      { "command": "gitOeil.checkout", "title": "Basculer sur la branche", "icon": "$(check)", "category": "Git Œil" },
      { "command": "gitOeil.branchDelete", "title": "Supprimer la branche…", "category": "Git Œil" },
      { "command": "gitOeil.stashPush", "title": "Stash des modifications…", "icon": "$(git-stash)", "category": "Git Œil" },
      { "command": "gitOeil.stashPushUntracked", "title": "Stash des modifications (avec fichiers non suivis)…", "category": "Git Œil" },
      { "command": "gitOeil.stashShow", "title": "Voir le contenu du stash", "icon": "$(eye)", "category": "Git Œil" },
      { "command": "gitOeil.stashApply", "title": "Appliquer le stash (apply)", "icon": "$(git-stash-apply)", "category": "Git Œil" },
      { "command": "gitOeil.stashPop", "title": "Appliquer et supprimer le stash (pop)", "icon": "$(git-stash-pop)", "category": "Git Œil" },
      { "command": "gitOeil.stashDrop", "title": "Supprimer le stash (drop)…", "icon": "$(trash)", "category": "Git Œil" },
      { "command": "gitOeil.showCommit", "title": "Voir le commit", "category": "Git Œil" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "gitOeil.checkout", "when": "false" },
        { "command": "gitOeil.branchDelete", "when": "false" },
        { "command": "gitOeil.stashShow", "when": "false" },
        { "command": "gitOeil.stashApply", "when": "false" },
        { "command": "gitOeil.stashPop", "when": "false" },
        { "command": "gitOeil.stashDrop", "when": "false" },
        { "command": "gitOeil.showCommit", "when": "false" }
      ],
      "view/title": [
        { "command": "gitOeil.stashPush", "when": "view == gitOeil.refs", "group": "navigation@1" },
        { "command": "gitOeil.refresh", "when": "view == gitOeil.refs", "group": "navigation@2" },
        { "command": "gitOeil.stashPushUntracked", "when": "view == gitOeil.refs", "group": "1_stash" }
      ],
      "view/item/context": [
        { "command": "gitOeil.stashPush", "when": "view == gitOeil.refs && viewItem == group.stashes", "group": "inline" },
        { "command": "gitOeil.checkout", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "inline" },
        { "command": "gitOeil.checkout", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "1_branch@1" },
        { "command": "gitOeil.branchDelete", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "1_branch@2" },
        { "command": "gitOeil.stashApply", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@1" },
        { "command": "gitOeil.stashPop", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@2" },
        { "command": "gitOeil.stashDrop", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@3" },
        { "command": "gitOeil.stashShow", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@1" },
        { "command": "gitOeil.stashApply", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@2" },
        { "command": "gitOeil.stashPop", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@3" },
        { "command": "gitOeil.stashDrop", "when": "view == gitOeil.refs && viewItem == stash", "group": "2_danger@1" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license",
    "test": "npm run compile && node --test out/test/"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.145.0",
    "typescript": "^7.0.2"
  }
}

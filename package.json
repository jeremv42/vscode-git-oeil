{
  "name": "git-oeil",
  "displayName": "Git Œil",
  "description": "Inline blame on the current line, plus a stashes / branches / recent branches view in Source Control.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Git Œil",
      "properties": {
        "gitOeil.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the blame at the end of the current line."
        },
        "gitOeil.blame.delayMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Delay (ms) after a cursor move or a keystroke before computing the blame."
        },
        "gitOeil.recentBranches.count": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Number of recently used branches (read from the reflog) to show. 0 hides the group."
        }
      }
    },
    "colors": [
      {
        "id": "gitOeil.blameForeground",
        "description": "Color of the end-of-line blame text.",
        "defaults": {
          "dark": "#ffffff55",
          "light": "#00000055",
          "highContrast": "#ffffff99",
          "highContrastLight": "#00000099"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitOeil.refs",
          "name": "Stashes & Branches",
          "icon": "$(git-branch)"
        }
      ]
    },
    "commands": [
      { "command": "gitOeil.toggleBlame", "title": "Git Œil: Toggle Inline Blame" },
      { "command": "gitOeil.refresh", "title": "Refresh", "icon": "$(refresh)", "category": "Git Œil" },
      { "command": "gitOeil.checkout", "title": "Switch to Branch", "icon": "$(check)", "category": "Git Œil" },
      { "command": "gitOeil.branchDelete", "title": "Delete Branch…", "category": "Git Œil" },
      { "command": "gitOeil.stashPush", "title": "Stash Changes…", "icon": "$(git-stash)", "category": "Git Œil" },
      { "command": "gitOeil.stashPushUntracked", "title": "Stash Changes (Include Untracked)…", "category": "Git Œil" },
      { "command": "gitOeil.stashShow", "title": "Show Stash Content", "icon": "$(eye)", "category": "Git Œil" },
      { "command": "gitOeil.stashApply", "title": "Apply Stash", "icon": "$(git-stash-apply)", "category": "Git Œil" },
      { "command": "gitOeil.stashPop", "title": "Pop Stash", "icon": "$(git-stash-pop)", "category": "Git Œil" },
      { "command": "gitOeil.stashDrop", "title": "Drop Stash…", "icon": "$(trash)", "category": "Git Œil" },
      { "command": "gitOeil.showCommit", "title": "Show Commit", "category": "Git Œil" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "gitOeil.checkout", "when": "false" },
        { "command": "gitOeil.branchDelete", "when": "false" },
        { "command": "gitOeil.stashShow", "when": "false" },
        { "command": "gitOeil.stashApply", "when": "false" },
        { "command": "gitOeil.stashPop", "when": "false" },
        { "command": "gitOeil.stashDrop", "when": "false" },
        { "command": "gitOeil.showCommit", "when": "false" }
      ],
      "view/title": [
        { "command": "gitOeil.stashPush", "when": "view == gitOeil.refs", "group": "navigation@1" },
        { "command": "gitOeil.refresh", "when": "view == gitOeil.refs", "group": "navigation@2" },
        { "command": "gitOeil.stashPushUntracked", "when": "view == gitOeil.refs", "group": "1_stash" }
      ],
      "view/item/context": [
        { "command": "gitOeil.stashPush", "when": "view == gitOeil.refs && viewItem == group.stashes", "group": "inline" },
        { "command": "gitOeil.checkout", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "inline" },
        { "command": "gitOeil.checkout", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "1_branch@1" },
        { "command": "gitOeil.branchDelete", "when": "view == gitOeil.refs && viewItem =~ /^(branch|recent)$/", "group": "1_branch@2" },
        { "command": "gitOeil.stashApply", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@1" },
        { "command": "gitOeil.stashPop", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@2" },
        { "command": "gitOeil.stashDrop", "when": "view == gitOeil.refs && viewItem == stash", "group": "inline@3" },
        { "command": "gitOeil.stashShow", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@1" },
        { "command": "gitOeil.stashApply", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@2" },
        { "command": "gitOeil.stashPop", "when": "view == gitOeil.refs && viewItem == stash", "group": "1_stash@3" },
        { "command": "gitOeil.stashDrop", "when": "view == gitOeil.refs && viewItem == stash", "group": "2_danger@1" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license",
    "test": "npm run compile && node --test out/test/"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.145.0",
    "typescript": "^7.0.2"
  }
}
